APP_NAME=Neurotech Events API
ENVIRONMENT=development
API_PREFIX=/api/v1
# Local default: file-backed SQLite, no setup required.
DATABASE_URL=sqlite:///./neurotech-events.db
# Managed PostgreSQL (Neon): use the psycopg driver scheme and keep TLS required.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require
DEBUG=true
# Interactive docs and /openapi.json. Defaults to on in development, off in production/staging.
# DOCS_ENABLED=true

# PostgreSQL pool (ignored for SQLite). Neon drops idle connections, so recycle early.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=300

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT access tokens for /api/v1/auth/*. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-development-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ISSUER=neurotech-events-api
JWT_AUDIENCE=neurotech-events

# Per-IP request budgets (per worker process; add an edge limiter for multi-instance deployments).
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
# Failed sign-ins per account and client IP (account-wide ceiling is 4x); successes never count.
LOGIN_FAILURES_PER_ACCOUNT_PER_MINUTE=5
PAYMENT_RATE_LIMIT_PER_MINUTE=10
CHECK_IN_RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BODY_BYTES=1048576

# Unpaid registrations hold a seat this long; polling hits the provider at most this often.
PENDING_REGISTRATION_HOLD_MINUTES=30
PAYMENT_SYNC_INTERVAL_SECONDS=5

# Public HTTPS origin of this API, used to build provider webhook URLs.
# Leave empty locally: payment status is then verified by polling the provider.
PUBLIC_BASE_URL=

# Optional static super-admin bearer token for /api/v1/admin/*. A logged-in
# platform_admin user (see `python -m app.db.create_admin`) is accepted as well.
# Generate with: openssl rand -hex 24
ADMIN_API_TOKEN=

# Snippe mobile-money collections (https://snippe.sh). Never commit real values.
SNIPPE_API_KEY=
# Settings -> Webhook Secret in the Snippe dashboard. Webhooks are rejected until this is set.
SNIPPE_WEBHOOK_SECRET=
SNIPPE_BASE_URL=https://api.snippe.sh
